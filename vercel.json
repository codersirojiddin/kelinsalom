{
  "version": 2,
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/sitemap.xml", "dest": "/api/index.go?sitemap=true" },
    { "src": "/poem/(?<id>[0-9]+)", "dest": "/api/poem.go?id=$id" },
    { "src": "/submit", "dest": "/api/submit.go" },
    { "src": "/(.*)", "dest": "/api/index.go" }
  ]
}